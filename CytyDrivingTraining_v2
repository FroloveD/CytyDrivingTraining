<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ================= параметры (метры, радианы, секунды) =================
// Kia Ceed: база 2,65 м, свесы ~0,88 и ~0,78 м, ширина 1,8 м.
// maxSteer подобран так, чтобы внешний передний угол кузова описывал окружность около 10,6 м (как у Ceed).
const CAR = { L: 2.65, rear: 0.78, front: 0.88, half: 0.9, maxSteer: 0.714 };
const CENTER = (CAR.L + CAR.front - CAR.rear) / 2;   // центр кузова от задней оси
const HALF_LEN = (CAR.rear + CAR.L + CAR.front) / 2; // половина длины кузова
const WHEEL_R = 0.33;

// размеры моделей, м. Длина, база и ширина — по спецификациям; свесы Rio и Ceed частично оценочные.
// rakeF / rakeR — наклон переднего и заднего стекла (седан: покатая корма, хэтчбек: почти вертикальная),
// lift — дополнительный клиренс, rails — рейлинги и защита (кроссовер)
const DIM = {
  // Габариты по спецификациям производителя (autotijd.be, carsguide.com.au, cars-data.com).
  // L — база, front/rear — свесы, w — ширина без зеркал, h — высота, track — колея.
