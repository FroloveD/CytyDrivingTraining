  // rF/rR — верх крыши спереди/сзади, yBelt — линия пояса, yn — нос, yRear — верх задней части.
  picanto: { name: 'Kia Picanto', L: 2.40,  front: 0.685, rear: 0.52,  w: 1.595, h: 1.485, track: 1.40,  lift: 0,    rails: false,
             p: { sF: 2.25, rF: 1.80, rR: 0.45, sR: -0.22, yBelt: 0.92, yRoof: 1.45, yn: 0.72, yRear: 1.02 } },
  rio:     { name: 'Kia Rio',     L: 2.57,  front: 0.81,  rear: 0.986, w: 1.72,  h: 1.45,  track: 1.51,  lift: 0,    rails: false, sedan: true,
             p: { sF: 2.25, rF: 1.65, rR: 0.42, sR: -0.25, yBelt: 0.92, yRoof: 1.38, yn: 0.64, yRear: 0.95 } },
  ceed:    { name: 'Kia Ceed',    L: 2.65,  front: 0.88,  rear: 0.78,  w: 1.80,  h: 1.447, track: 1.57,  lift: 0,    rails: false,
             p: { sF: 2.45, rF: 1.85, rR: 0.55, sR: -0.15, yBelt: 0.92, yRoof: 1.37, yn: 0.66, yRear: 1.00 } },
  xceed:   { name: 'Kia XCeed',   L: 2.65,  front: 0.905, rear: 0.84,  w: 1.80,  h: 1.483, track: 1.585, lift: 0.08, rails: true,
             p: { sF: 2.35, rF: 1.95, rR: 0.85, sR: 0.00, yBelt: 1.00, yRoof: 1.40, yn: 0.74, yRear: 1.12 } },
  sorento: { name: 'Kia Sorento', L: 2.815, front: 0.925, rear: 1.075, w: 1.90,  h: 1.695, track: 1.65,  lift: 0.10, rails: true,
             p: { sF: 2.95, rF: 2.30, rR: 0.25, sR: 0.00, yBelt: 1.12, yRoof: 1.66, yn: 0.92, yRear: 1.28 } }
};
const BAY = { w: 2.5, l: 5.3 };   // размер бокса для легкового авто (предварительно, см. памятку)
const AISLE = 6.0;                // проезд между рядами (предварительно)
const COLS = 4;                   // боксов в каждом ряду
const START = { x: 0, z: 2.5, h: 0 };  // в проезде между рядами, heading 0 = +Z
const CONE_R = 0.25;
const PARKED_COLORS = [0x9e9e9e, 0xc0392b, 0x2e7d32, 0xf5f5f5, 0x6d4c41];
// модель в занятых боксах (номер бокса -> ключ DIM)
const PARKED_MODEL = { 1: 'picanto', 3: 'xceed', 6: 'rio', 8: 'sorento' };
const PARKED_COLOR = { 1: 0xf2c200, 3: 0xf5f5f5, 6: 0x2e5fa8, 8: 0x4a4f55 };

// препятствия: прямоугольники (AABB) — заполняются ниже; конусы — круглые
const blocks = [];

// ================= состояние =================
const state = { ...START, v: 0, steer: 0 };
const keys = {};
let gear = 'D';
// вид камеры: орбита вокруг машины (yaw — отклонение от «сзади», el — угол над горизонтом, r — расстояние)
const VIEW_PRESETS = [
  { name: 'Сзади',          r: 10, el: 0.45 },
  { name: 'Сзади, дальше',  r: 20, el: 0.40 },
  { name: 'Сверху-сзади',   r: 12, el: 0.95 },
  { name: 'Сверху',         r: 28, el: 1.45 }
];
const view = { yaw: 0, el: VIEW_PRESETS[0].el, r: VIEW_PRESETS[0].r };
let presetIndex = 0;
let wheelSpin = 0;
let signal = null;   // null | 'L' | 'R'
let prevV = 0, pitchCur = 0, rollCur = 0;   // подвеска: продольный и поперечный крен кузова
let dragBtn = -1, lastX = 0, lastY = 0;
let steerSens = 1;   // чувствительность руля (ЛКМ), ползунок
let camSens = 1;     // чувствительность камеры (ПКМ), ползунок
// руль: угол рулевого колеса в градусах; ~2,7 оборота на упор (как у легковых), 1 оборот ≈ 250 px
let swDeg = 0;
const SW = { degPerPx: 1.44, maxDeg: 486, ratio: 11.9 };   // ratio: градусы руля на градус колёс
let collisions = 0, elapsed = 0, holdT = 0, finished = false, contact = false, score = 0;
let finishedBay = null;

const statusEl = document.getElementById('status');
const el = id => document.getElementById(id);

// ================= сцена =================
const scene = new THREE.Scene();
const skyCanvas = document.createElement('canvas');
skyCanvas.width = 2; skyCanvas.height = 256;
const skyCtx = skyCanvas.getContext('2d');
const skyGrad = skyCtx.createLinearGradient(0, 0, 0, 256);
skyGrad.addColorStop(0, '#5d8fc4');
skyGrad.addColorStop(0.55, '#b9d4e8');
skyGrad.addColorStop(1, '#dfe9f0');
skyCtx.fillStyle = skyGrad;
skyCtx.fillRect(0, 0, 2, 256);
scene.background = new THREE.CanvasTexture(skyCanvas);
scene.fog = new THREE.Fog(0xc4d8e6, 60, 220);

const camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.1, 500);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.0;
renderer.setSize(innerWidth, innerHeight);
document.body.appendChild(renderer.domElement);

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

scene.add(new THREE.HemisphereLight(0xdfeaf5, 0x5a5e62, 0.5));
const sun = new THREE.DirectionalLight(0xffffff, 1.3);
sun.position.set(10, 22, 8);
sun.castShadow = true;
sun.shadow.mapSize.set(4096, 4096);
sun.shadow.camera.left = -25; sun.shadow.camera.right = 25;
sun.shadow.camera.top = 25;   sun.shadow.camera.bottom = -25;
sun.shadow.camera.near = 1;   sun.shadow.camera.far = 80;
sun.shadow.bias = -0.0005;
sun.target.position.set(0, 0, 5);
scene.add(sun, sun.target);

const mat = color => new THREE.MeshLambertMaterial({ color });
const matStd = (color, metalness = 0.2, roughness = 0.5) => new THREE.MeshStandardMaterial({ color, metalness, roughness });
function addBox(w, h, d, x, y, z, color) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat(color));
  m.position.set(x, y, z);
  scene.add(m);
  return m;
}

// автомобиль: origin группы — задняя ось, локальная +Z — вперёд
// текстура таблички «У» (учебное транспортное средство): белый квадрат, красная кайма, чёрная буква
function makeLearnerSignTexture() {
  const c = document.createElement('canvas');
  c.width = c.height = 256;
  const g = c.getContext('2d');
  g.fillStyle = '#ffffff';
  g.fillRect(0, 0, 256, 256);
  g.strokeStyle = '#d32f2f';
  g.lineWidth = 26;
  g.strokeRect(13, 13, 230, 230);
  g.fillStyle = '#111111';
  g.font = 'bold 170px Arial, sans-serif';
  g.textAlign = 'center';
  g.textBaseline = 'middle';
  g.fillText('У', 128, 136);
  return new THREE.CanvasTexture(c);
}

// скруглённый параллелепипед: вершины сдвигаются к поверхности сферы радиуса r
function roundedBoxGeo(w, h, d, r, seg) {
  const geo = new THREE.BoxGeometry(w, h, d, seg, seg, seg);
  const pos = geo.attributes.position;
  const hw = w / 2 - r, hh = h / 2 - r, hd = d / 2 - r;
  const v = new THREE.Vector3();
  for (let i = 0; i < pos.count; i++) {
    v.fromBufferAttribute(pos, i);
    const ix = Math.min(hw, Math.max(-hw, v.x));
    const iy = Math.min(hh, Math.max(-hh, v.y));
    const iz = Math.min(hd, Math.max(-hd, v.z));
    const dx = v.x - ix, dy = v.y - iy, dz = v.z - iz;
    const len = Math.hypot(dx, dy, dz);
    if (len > 0) v.set(ix + dx / len * r, iy + dy / len * r, iz + dz / len * r);
    pos.setXYZ(i, v.x, v.y, v.z);
  }
  geo.computeVertexNormals();
  return geo;
}

// произвольная деформация вершин геометрии
function deform(geo, fn) {
  const pos = geo.attributes.position;
  const v = new THREE.Vector3();
  for (let i = 0; i < pos.count; i++) {
    v.fromBufferAttribute(pos, i);
    fn(v);
    pos.setXYZ(i, v.x, v.y, v.z);
  }
  geo.computeVertexNormals();
  return geo;
}

// выдавливание бокового профиля по ширине: точки (z, y), ось X — поперёк машины
function extrudeSide(points, width, bevel = 0.03) {
  const shape = new THREE.Shape();
  shape.moveTo(points[0][0], points[0][1]);
  for (let i = 1; i < points.length; i++) shape.lineTo(points[i][0], points[i][1]);
  shape.closePath();
  const geo = new THREE.ExtrudeGeometry(shape, {
    depth: width, bevelEnabled: true, bevelThickness: bevel, bevelSize: bevel * 0.8, bevelSegments: 3, curveSegments: 1, steps: 1
  });
  geo.translate(0, 0, -width / 2);   // центрируем по ширине
  geo.rotateY(-Math.PI / 2);         // форма (x → z), ширина (z → -x)
  geo.computeVertexNormals();
  return geo;
}

// отрезок между двумя точками: цилиндр единичной высоты, растягивается и поворачивается
function setLink(mesh, a, b) {
  const dir = new THREE.Vector3().subVectors(b, a);
  const len = dir.length();
  mesh.position.copy(a).add(b).multiplyScalar(0.5);
  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.clone().normalize());
  mesh.scale.set(1, len, 1);
}

// поворот вектора вокруг вертикальной оси (для руля передних колёс)
function rotY(v, a) {
  const c = Math.cos(a), sn = Math.sin(a);
  return new THREE.Vector3(v.x * c + v.z * sn, v.y, -v.x * sn + v.z * c);
}

// подвеска: стойка с пружиной, нижние рычаги и рулевая тяга (передние колёса поворачиваются с рулём)
function updateLinks(g, chassis, steer) {
  const toChassis = v => v.clone().applyEuler(chassis.rotation).add(chassis.position);
  const Z = new THREE.Vector3(0, 0, 1);
  for (const l of g.userData.links) {
    const a = l.steer * steer;
    const hubPt = off => l.origin.clone().add(rotY(off, a));
    const top = toChassis(l.strutTop);
    const bottom = hubPt(l.strutOff);
    setLink(l.strut, bottom, top);
    const dir = top.clone().sub(bottom).normalize();
    l.coils.forEach((ring, k) => {
      const t = 0.3 + 0.45 * k / (l.coils.length - 1);
      ring.position.copy(bottom).lerp(top, t);
      ring.quaternion.setFromUnitVectors(Z, dir);
    });
    const joint = hubPt(l.joinOff);
    setLink(l.legA, joint, toChassis(l.legA_pt));
    setLink(l.legB, joint, toChassis(l.legB_pt));
    if (l.tie) setLink(l.tie, hubPt(l.tieOff), toChassis(l.rackPt));
  }
}

function makeCar(color, d = DIM.ceed, opts = {}) {
  const g = new THREE.Group();
  const chassis = new THREE.Group();   // кузов: крен и тангаж при разгоне, торможении, повороте
  g.add(chassis);
  const p = d.p;
  const sw = d.w / 1.8;                    // масштаб ширины относительно Ceed
  const zF = d.L + d.front, zR = -d.rear;
  const yb = 0.22 + d.lift;                // низ кузова
  const half = d.w / 2 + 0.03;             // боковая поверхность с учётом фаски
  const wOff = d.track / 2;   // колея из спецификации: колёса внутри ниши
  const zB = (p.sF + p.sR) / 2;            // стойка B (между передней и задней дверью)
  const zFD = p.sF - 0.05;                 // передний край передней двери
  const zRD = p.sR - 0.1;                  // задний край задней двери
  const yMid = (yb + p.yBelt) / 2;

  const paint = matStd(color, 0.35, 0.35);
  const glass = new THREE.MeshStandardMaterial({
    color: 0x2a4a66, metalness: 0.3, roughness: 0.05, transparent: true, opacity: 0.3, depthWrite: false, side: THREE.DoubleSide
  });
  const trim = matStd(0x151515, 0.1, 0.7);
  const seat = matStd(0x2a2a2a, 0.0, 0.9);
  const dash = matStd(0x1e1e1e, 0.0, 0.8);
  const plate = matStd(0xf2f2f2, 0.0, 0.6);
  const lightW = new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0xfff3c4, emissiveIntensity: 0.6 });
  const lightR = new THREE.MeshStandardMaterial({ color: 0xaa1111, emissive: 0xff2020, emissiveIntensity: 0.5 });
  const ampL = new THREE.MeshStandardMaterial({ color: 0xff9a00, emissive: 0xff8000, emissiveIntensity: 0 });
  const ampR = ampL.clone();

  const add = (geo, m, x, y, z) => {
    const mesh = new THREE.Mesh(geo, m);
    mesh.position.set(x, y, z);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    chassis.add(mesh);
    return mesh;
  };

  // кузов по боковому силуэту
  // контактная тень под кузовом
  const shadowCanvas = document.createElement('canvas');
  shadowCanvas.width = shadowCanvas.height = 128;
  const shCtx = shadowCanvas.getContext('2d');
  const shGrad = shCtx.createRadialGradient(64, 64, 10, 64, 64, 64);
  shGrad.addColorStop(0, 'rgba(0,0,0,0.55)');
  shGrad.addColorStop(1, 'rgba(0,0,0,0)');
  shCtx.fillStyle = shGrad;
  shCtx.fillRect(0, 0, 128, 128);
  const contactShadow = new THREE.Mesh(
    new THREE.PlaneGeometry(d.w * 1.25, (zF - zR) * 1.1),
    new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(shadowCanvas), transparent: true, depthWrite: false })
  );
  contactShadow.rotation.x = -Math.PI / 2;
  contactShadow.position.set(0, 0.012, (zF + zR) / 2);
  g.add(contactShadow);

  // полый кузов: нижний контур с вырезами под колёса; толщина стенок 4 см, внутри — салон
  const Rn = WHEEL_R + 0.09;
  const WALL = 0.04;
  const notchEdge = (yBot, R, zA, zB) => {
    const sN = Math.max(-1, Math.min(1, (yBot - WHEEL_R) / R));
    const thL = Math.PI - Math.asin(sN), thR = Math.asin(sN);
    const pts = [[zA, yBot]];
    for (const wz of [0, d.L]) {
      for (let i = 0; i <= 12; i++) {
        const th = thL + (thR - thL) * i / 12;
        pts.push([wz + R * Math.cos(th), WHEEL_R + R * Math.sin(th)]);
      }
    }
    pts.push([zB, yBot]);
    return pts;
  };
  const outerPts = notchEdge(yb, Rn, zR, zF).concat([[zF, p.yn], [p.sF, p.yBelt], [p.sR, p.yBelt], [zR, p.yRear]]);
  const yBi = p.yBelt - WALL, ybi = yb + WALL;
  const innerPts = notchEdge(ybi, Rn + WALL, zR + WALL, zF - WALL)
    .concat([[zF - WALL, p.yn - WALL], [p.sF - 0.03, yBi], [p.sR + 0.03, yBi], [zR + WALL, p.yRear - WALL]]);
  // каркас с полостью: верх, низ, передняя и задняя части — стенки; боковины — отдельные панели
  const shell = new THREE.Shape(outerPts.map(([x, y]) => new THREE.Vector2(x, y)));
  shell.holes.push(new THREE.Path(innerPts.map(([x, y]) => new THREE.Vector2(x, y))));
  const shellGeo = new THREE.ExtrudeGeometry(shell, { depth: d.w - 0.08, bevelEnabled: false, curveSegments: 1, steps: 1 });
  shellGeo.translate(0, 0, -(d.w - 0.08) / 2);
  shellGeo.rotateY(-Math.PI / 2);
  shellGeo.computeVertexNormals();
  add(shellGeo, paint, 0, 0, 0);
  // боковины с выпуклостью по высоте и сужением к носу и корме (не прямоугольное корыто)
  const cEnd = (zF + zR) / 2, hEnd = (zF - zR) / 2;
  const sidePanel = sgn => {
    const geo = extrudeSide(outerPts, WALL, 0.004);
    geo.translate(sgn * (half - WALL / 2), 0, 0);
    deform(geo, v => {
      const h = Math.min(1, Math.max(0, (v.y - yb) / (p.yBelt - yb)));
      const zn = (v.z - cEnd) / hEnd;
      const bulge = 1 + 0.03 * Math.sin(Math.PI * h);
      const nose = 1 - 0.06 * Math.max(0, Math.abs(zn) - 0.75) / 0.25;
      v.x *= bulge * nose;
    });
    add(geo, paint, 0, 0, 0);
  };
  sidePanel(-1);
  sidePanel(1);
  // прозрачное остекление салона и окрашенная крыша
  // остекление сужается к крыше, как у настоящего кузова
  const glassGeo = extrudeSide([[p.sF, p.yBelt - 0.04], [p.rF, p.yRoof], [p.rR, p.yRoof], [p.sR, p.yBelt - 0.04]], 1.5 * sw);
  deform(glassGeo, v => {
    const t = Math.min(1, Math.max(0, (v.y - (p.yBelt - 0.04)) / (p.yRoof - (p.yBelt - 0.04))));
    v.x *= 1 - 0.08 * t;
  });
  add(glassGeo, glass, 0, 0, 0).renderOrder = 2;
  const roofGeo = extrudeSide([[p.rF, p.yRoof - 0.02], [p.rR, p.yRoof - 0.02], [p.rR, p.yRoof + 0.02], [p.rF, p.yRoof + 0.02]], 1.42 * sw, 0.01);
  deform(roofGeo, v => { v.x *= 0.92; });
  add(roofGeo, paint, 0, 0, 0);

  // салон: приборная панель, руль, сиденья
  const zFS = (p.sF + p.rR) / 2 - 0.2;     // переднее сиденье
  const zRS = zFS - 0.9;                   // заднее сиденье
  add(roundedBoxGeo(1.4 * sw, 0.14, 0.32, 0.04, 2), dash, 0, p.yBelt + 0.04, p.sF - 0.25);
  const steerWheel = new THREE.Group();   // руль слева (водитель слева), вращается вокруг своей оси
  steerWheel.position.set(0.36 * sw, 1.0, zFS + 0.5);
  steerWheel.rotation.x = -0.5;
  const steerRim = new THREE.Mesh(new THREE.TorusGeometry(0.17, 0.02, 8, 18), trim);
  const steerSpoke = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.03, 0.02), trim);
  steerWheel.add(steerRim, steerSpoke);
  chassis.add(steerWheel);
  g.userData.steerWheel = steerWheel;

  if (opts.driver) {
    const dx = 0.36 * sw, zD = zFS;
    const hipY = yb + 0.42, shoulderY = yb + 0.8, headY = yb + 1.0;
    const shirt = matStd(0x2d4f7a, 0.0, 0.8);
    const pants = matStd(0x2a2a30, 0.0, 0.9);
    const skin = matStd(0xd9a77f, 0.0, 0.6);
    const hair = matStd(0x2b1d14, 0.0, 0.7);
    const shoe = matStd(0x111111, 0.0, 0.8);
    const limbGeo = new THREE.CylinderGeometry(0.06, 0.06, 1, 8);
    const armGeo = new THREE.CylinderGeometry(0.045, 0.045, 1, 8);
    const limb = (a, b, m, geo) => { const mesh = new THREE.Mesh(geo, m); setLink(mesh, a, b); chassis.add(mesh); return mesh; };

    // торс, голова, волосы
    add(roundedBoxGeo(0.4, 0.44, 0.26, 0.08, 3), shirt, dx, yb + 0.64, zD - 0.02);
    add(new THREE.SphereGeometry(0.11, 16, 12), skin, dx, headY, zD - 0.03);
    add(new THREE.SphereGeometry(0.115, 16, 12, 0, Math.PI * 2, 0, Math.PI / 2), hair, dx, headY + 0.01, zD - 0.03);

    // ноги: бедро, голень, стопа
    for (const k of [-0.1, 0.1]) {
      limb(new THREE.Vector3(dx + k, hipY, zD), new THREE.Vector3(dx + k, hipY, zD + 0.42), pants, limbGeo);
      limb(new THREE.Vector3(dx + k, hipY, zD + 0.42), new THREE.Vector3(dx + k, yb + 0.1, zD + 0.5), pants, limbGeo);
      add(roundedBoxGeo(0.12, 0.1, 0.22, 0.03, 2), shoe, dx + k, yb + 0.06, zD + 0.6);
    }

    // руки: плечо → локоть (статично), локоть → кисть (следует за рулём)
    const arms = [];
    for (const k of [-1, 1]) {
      const shoulder = new THREE.Vector3(dx + 0.22 * k, shoulderY, zD - 0.02);
      const elbow = new THREE.Vector3(dx + 0.28 * k, shoulderY - 0.3, zD + 0.22);
      const upper = limb(shoulder, elbow, shirt, armGeo);
      const fore = limb(elbow, elbow, shirt, armGeo);
      const hand = add(new THREE.SphereGeometry(0.04, 10, 8), skin, 0, 0, 0);
      arms.push({ k, elbow, fore, hand });
    }
    g.userData.updateDriver = () => {
      for (const a of arms) {
        // кисти на ободе руля: 9 и 3 часа, с учётом поворота руля
        const rimPt = new THREE.Vector3(0.17 * a.k * -1, 0, 0).applyEuler(steerWheel.rotation).add(steerWheel.position);
        setLink(a.fore, a.elbow, rimPt);
        a.hand.position.copy(rimPt);
      }
    };
    g.userData.updateDriver();
  }
  for (const z of [zFS, zRS]) for (const x of [-0.36, 0.36]) {
    add(roundedBoxGeo(0.42 * sw, 0.12, 0.45, 0.03, 2), seat, x * sw, yb + 0.3, z);
    add(roundedBoxGeo(0.42 * sw, 0.5, 0.1, 0.03, 2), seat, x * sw, yb + 0.6, z - 0.25);
  }

  // стойки кузова A, B, C — по краям остекления, как в настоящей машине
  const pillarGeo = new THREE.CylinderGeometry(0.022, 0.022, 1, 6);
  const pillarMat = matStd(0x101010, 0.2, 0.6);
  const pillar = (a, b) => {
    const m = new THREE.Mesh(pillarGeo, pillarMat);
    setLink(m, a, b);
    chassis.add(m);
  };
  for (const sx of [-1, 1]) {
    const X = sx * 0.7 * sw;
    pillar(new THREE.Vector3(X, p.yBelt, p.sF - 0.02), new THREE.Vector3(X, p.yRoof, p.rF));
    pillar(new THREE.Vector3(X, p.yBelt, zB), new THREE.Vector3(X, p.yRoof, (p.rF + p.rR) / 2));
    pillar(new THREE.Vector3(X, p.yBelt, p.sR), new THREE.Vector3(X, p.yRoof, p.rR));
  }

  // рулевая колонка и центральная консоль
  const column = new THREE.Mesh(pillarGeo, pillarMat);
  setLink(column, new THREE.Vector3(0.36 * sw, 1.0, zFS + 0.5), new THREE.Vector3(0.3 * sw, p.yBelt + 0.12, zFS + 0.2));
  chassis.add(column);
  add(roundedBoxGeo(0.3 * sw, 0.12, 0.7, 0.03, 2), dash, 0, yb + 0.32, zFS - 0.1);

  // двери: швы — тонкие тёмные полоски на боковине (не выступающие бруски), ручки, зеркала
  const seamMat = new THREE.MeshLambertMaterial({ color: 0x0d0d0d, side: THREE.DoubleSide });
  const seam = (zLen, yLen, xs, y, z) => {
    const m = new THREE.Mesh(new THREE.PlaneGeometry(zLen, yLen), seamMat);
    m.rotation.y = Math.PI / 2;
    m.position.set(xs, y, z);
    chassis.add(m);
  };
  for (const s of [-1, 1]) {
    const x = s * (half + 0.0008);
    // швы не должны проходить через колёсные ниши: в зоне ниши вертикальный шов начинается над ней,
    // а порожек обрывается у ниш
    const vSeam = zc => {
      const inNotch = [0, d.L].some(wz => Math.abs(zc - wz) < Rn);
      const yLo = inNotch ? WHEEL_R + Rn + 0.02 : yb + 0.1;
      const yHi = p.yBelt - 0.02;
      seam(0.006, yHi - yLo, x, (yLo + yHi) / 2, zc);
    };
    vSeam(zFD);
    vSeam(zB);
    vSeam(zRD);
    const z0 = Math.max(zRD, Rn), z1 = Math.min(zFD, d.L - Rn);
    if (z1 > z0) seam(z1 - z0, 0.006, x, yb + 0.12, (z0 + z1) / 2);
    add(new THREE.BoxGeometry(0.02, 0.03, 0.09), trim, s * (half + 0.01), p.yBelt - 0.12, (zFD + zB) / 2 + 0.05);
    add(new THREE.BoxGeometry(0.02, 0.03, 0.09), trim, s * (half + 0.01), p.yBelt - 0.12, (zB + zRD) / 2);
    add(roundedBoxGeo(0.12, 0.1, 0.2, 0.03, 2), paint, s * (half + 0.06), p.yBelt + 0.03, p.sF - 0.15);
  }

  // лючок бензобака: слева (-X), задняя четверть (у Kia — с левой стороны, по данным источников)
  add(new THREE.BoxGeometry(0.01, 0.2, 0.2), matStd(0x3a3a3a, 0.2, 0.6), (half + 0.004), 0.62, -0.45);

  // решётка радиатора: хромированная рамка и тёмная сетка; противотуманные фары
  const chrome = matStd(0xc8ccd2, 0.9, 0.25);
  const grilleMesh = matStd(0x101010, 0.3, 0.6);
  add(roundedBoxGeo(d.w * 0.55, 0.2, 0.03, 0.01, 1), chrome, 0, (yb + p.yn) / 2 - 0.02, zF + 0.035);
  add(roundedBoxGeo(d.w * 0.5, 0.17, 0.03, 0.01, 1), grilleMesh, 0, (yb + p.yn) / 2 - 0.02, zF + 0.05);
  for (const x of [-0.6, 0.6]) {
    const fog = add(new THREE.CylinderGeometry(0.06, 0.06, 0.03, 14), matStd(0xe0e0e0, 0.1, 0.4), x * sw, yb + 0.07, zF + 0.03);
    fog.rotation.x = Math.PI / 2;
  }
  // шов крышки багажника у седана: тонкая полоска на крышке
  if (d.sedan) {
    const trunkSeam = new THREE.Mesh(new THREE.PlaneGeometry(d.w * 0.9, 0.006), seamMat);
    trunkSeam.rotation.x = -Math.PI / 2;
    trunkSeam.position.set(0, p.yRear + 0.002, p.sR);
    chassis.add(trunkSeam);
  }

  // передние и задние фонари, поворотники, бамперы, номера
  const lightY = (yb + p.yn) / 2 + 0.02;
  const rearLightY = (yb + p.yRear) / 2 + 0.05;
  for (const x of [-0.55, 0.55]) {
    add(roundedBoxGeo(0.42 * sw, 0.1, 0.05, 0.03, 2), lightW, x * sw, lightY, zF + 0.04);
    add(roundedBoxGeo(0.42 * sw, 0.1, 0.05, 0.03, 2), lightR, x * sw, rearLightY, zR - 0.04);
  }
  add(roundedBoxGeo(0.14, 0.08, 0.04, 0.02, 2), ampL, 0.8 * sw, lightY - 0.1, zF + 0.03);
  add(roundedBoxGeo(0.14, 0.08, 0.04, 0.02, 2), ampL, 0.8 * sw, rearLightY - 0.1, zR - 0.03);
  add(roundedBoxGeo(0.14, 0.08, 0.04, 0.02, 2), ampR, -0.8 * sw, lightY - 0.1, zF + 0.03);
  add(roundedBoxGeo(0.14, 0.08, 0.04, 0.02, 2), ampR, -0.8 * sw, rearLightY - 0.1, zR - 0.03);
  add(roundedBoxGeo(d.w * 0.98, 0.16, 0.1, 0.04, 2), trim, 0, yb + 0.06, zF + 0.01);
  add(roundedBoxGeo(d.w * 0.98, 0.16, 0.1, 0.04, 2), trim, 0, yb + 0.06, zR - 0.01);
  add(new THREE.BoxGeometry(0.5 * sw, 0.14, 0.03), plate, 0, yb + 0.16, zF + 0.04);
  add(new THREE.BoxGeometry(0.5 * sw, 0.14, 0.03), plate, 0, yb + 0.16, zR - 0.04);

  // рейлинги и защита (кроссовер)
  const roofTop = p.yRoof + 0.02;
  if (d.rails) {
    for (const x of [-0.7, 0.7]) add(roundedBoxGeo(0.06, 0.04, p.rF - p.rR, 0.01, 1), trim, x * sw, roofTop + 0.02, (p.rF + p.rR) / 2);
    add(roundedBoxGeo(1.6 * sw, 0.1, 0.1, 0.03, 2), trim, 0, yb - 0.04, zF - 0.05);
  }

  // табличка «У»
  if (opts.sign) {
    const sign = new THREE.Mesh(
      new THREE.PlaneGeometry(0.3, 0.3),
      new THREE.MeshBasicMaterial({ map: makeLearnerSignTexture(), side: THREE.DoubleSide })
    );
    sign.position.set(0, roofTop + 0.2, (p.rF + p.rR) / 2);
    chassis.add(sign);
    add(new THREE.BoxGeometry(0.05, 0.2, 0.05), trim, 0, roofTop + 0.1, (p.rF + p.rR) / 2);
  }

  // колёсные ниши: в кузове вырезаны дуги (см. нижний контур). Внутри каждой ниши — тёмный подкрылок,
  // он закрывает стойку и пружину, поэтому снаружи видны только колесо и крыло над ним
  const liner = new THREE.Shape();
  liner.moveTo(-Rn, yb - WHEEL_R);
  liner.lineTo(Rn, yb - WHEEL_R);
  liner.lineTo(Rn, 0);
  liner.absarc(0, 0, Rn, 0, Math.PI, false);
  liner.lineTo(-Rn, yb - WHEEL_R);
  const linerGeo = new THREE.ShapeGeometry(liner, 24);
  const linerMat = matStd(0x161616, 0.0, 0.95);
  linerMat.side = THREE.DoubleSide;
  for (const s2 of [-1, 1]) for (const z of [0, d.L]) {
    const pl = new THREE.Mesh(linerGeo, linerMat);
    pl.rotation.y = Math.PI / 2;
    pl.position.set(s2 * (wOff - 0.15), WHEEL_R, z);   // подкрылок за колесом, внутри ниши
    chassis.add(pl);
  }

  // днище и выхлоп
  add(roundedBoxGeo(d.w * 0.9, 0.05, d.L - 0.9, 0.02, 2), matStd(0x1b1b1b, 0.3, 0.8), 0, yb - 0.03, d.L / 2);
  const exhaust = add(new THREE.CylinderGeometry(0.03, 0.03, 0.24, 8), matStd(0x2b2b2b, 0.8, 0.4), 0.25 * sw, yb - 0.06, zR + 0.1);
  exhaust.rotation.x = Math.PI / 2;

  // подвеска: стойка с пружиной, два нижних рычага и рулевая тяга (у передних колёс); рейка — на кузове
  const linkMat = matStd(0x3a3e44, 0.6, 0.5);
  const springMat = matStd(0x7a7f87, 0.8, 0.35);
  const linkGeo = new THREE.CylinderGeometry(0.022, 0.022, 1, 6);
  const coilGeo = new THREE.TorusGeometry(0.05, 0.008, 6, 12);
  const rack = add(new THREE.CylinderGeometry(0.018, 0.018, 1.0, 6), linkMat, 0, yb + 0.04, d.L - 0.45);
  rack.rotation.z = Math.PI / 2;
  g.userData.links = [];
  for (const [x, z, front] of [[-0.85, 0, false], [0.85, 0, false], [-0.85, d.L, true], [0.85, d.L, true]]) {
    const sg = Math.sign(x);
    const strut = new THREE.Mesh(linkGeo, linkMat);
    strut.visible = false;   // стойка скрыта подкрылком и крылом, как в реальной машине
    g.add(strut);
    const coils = [];
    for (let k = 0; k < 6; k++) {
      const ring = new THREE.Mesh(coilGeo, springMat);
      ring.visible = false;   // пружина скрыта внутри ниши
      g.add(ring);
      coils.push(ring);
    }
    const legA = new THREE.Mesh(linkGeo, linkMat), legB = new THREE.Mesh(linkGeo, linkMat);
    g.add(legA, legB);
    let tie = null;
    if (front) { tie = new THREE.Mesh(linkGeo, linkMat); g.add(tie); }
    g.userData.links.push({
      origin: new THREE.Vector3(sg * wOff, WHEEL_R, z),
      steer: front ? 1 : 0,
      strut, coils, legA, legB, tie,
      strutOff: new THREE.Vector3(0, 0.25, 0.02),         // верх ступицы относительно центра колеса
      strutTop: new THREE.Vector3(sg * wOff * 0.5, yb + 0.7, z + 0.05),   // башня стойки в кузове
      joinOff: new THREE.Vector3(0, -0.2, 0),              // нижний шаровой шарнир
      legA_pt: new THREE.Vector3(sg * wOff * 0.45, yb + 0.02, z + 0.4),
      legB_pt: new THREE.Vector3(sg * wOff * 0.45, yb + 0.02, z - 0.4),
      tieOff: new THREE.Vector3(0, -0.05, -0.22),          // рычаг поворотного кулака
      rackPt: new THREE.Vector3(sg * 0.42, yb + 0.04, d.L - 0.45)
    });
  }

  // колёса: резина и диск; передние — поворотный узел, все — вращаются
  // колесо: плоский протектор шириной 200 мм, диск с пятью спицами и ступичная крышка на обеих сторонах
  const tireGeo = new THREE.CylinderGeometry(WHEEL_R, WHEEL_R, 0.2, 28);
  const tireMat = matStd(0x141414, 0.0, 0.92);
  const faceGeo = new THREE.CylinderGeometry(0.2, 0.2, 0.012, 24);
  const faceMat = matStd(0x2a2d32, 0.5, 0.4);
  const spokeGeo = new THREE.BoxGeometry(0.05, 0.02, 0.15);
  const spokeMat = matStd(0xb8bec5, 0.8, 0.3);
  const hubGeo = new THREE.CylinderGeometry(0.06, 0.06, 0.02, 14);
  g.userData.wheels = [];
  g.userData.frontPivots = [];
  for (const [x, z, front] of [[-0.85, 0, false], [0.85, 0, false], [-0.85, d.L, true], [0.85, d.L, true]]) {
    const pivot = new THREE.Group();
    pivot.position.set(Math.sign(x) * wOff, WHEEL_R, z);
    const axle = new THREE.Group();
    axle.rotation.z = Math.PI / 2;
    const w = new THREE.Group();
    const tire = new THREE.Mesh(tireGeo, tireMat);
    tire.castShadow = true;
    w.add(tire);
    for (const sy of [-1, 1]) {
      const face = new THREE.Mesh(faceGeo, faceMat);
      face.position.y = sy * 0.1;
      w.add(face);
      const hub = new THREE.Mesh(hubGeo, spokeMat);
      hub.position.y = sy * 0.112;
      w.add(hub);
      for (let k = 0; k < 5; k++) {
        const a = k * Math.PI * 2 / 5;
        const sp = new THREE.Mesh(spokeGeo, spokeMat);
        sp.position.set(Math.sin(a) * 0.12, sy * 0.112, Math.cos(a) * 0.12);
        sp.rotation.y = a;
        w.add(sp);
      }
    }
    axle.add(w);
    pivot.add(axle);
    g.add(pivot);
    g.userData.wheels.push(w);
    if (front) g.userData.frontPivots.push(pivot);
  }
  g.userData.ampL = ampL;
  g.userData.ampR = ampR;
  g.userData.chassis = chassis;
  g.userData.refreshLinks = (steer = 0) => updateLinks(g, chassis, steer);
  updateLinks(g, chassis, 0);
  return g;
}

