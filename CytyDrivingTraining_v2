function loadOsm(inputData, options = {}) {
  // GeoJSON нормализуем; OSM JSON оставляем в исходном формате.
  const data = inputData && inputData.type === 'FeatureCollection' ? geoJsonToOsm(inputData) : inputData;
  // Проверяем структуру до очистки текущего города.
  if (!data || !Array.isArray(data.elements)) {
    throw new Error('неверный формат: ожидался OSM JSON или GeoJSON FeatureCollection');
  }

  const nodes = new Map();
  for (const el of data.elements) {
    if (el && el.type === 'node' && Number.isFinite(el.lat) && Number.isFinite(el.lon)) {
      nodes.set(el.id, el);
    }
  }
  const ways = data.elements.filter(el => el && el.type === 'way' && Array.isArray(el.nodes));
  if (!nodes.size || !ways.length) {
    throw new Error('в файле не найдены узлы и линейные объекты OSM');
  }

  // В режиме замены очищаем старые районы только после проверки нового набора.
  if (options.append !== true) clearOsmMap();

  // Все добавляемые районы используют единый географический якорь,
  // поэтому соседние выгрузки не накладываются друг на друга.
  let la = 0, lo = 0, cnt = 0;
  for (const n of nodes.values()) { la += n.lat; lo += n.lon; cnt++; }
  if (!mapProjectionCenter) mapProjectionCenter = { lat: la / cnt, lon: lo / cnt };
  const c = mapProjectionCenter;
  const layerId = options.layerId || nextMapLayerId++;
  activeOsmLayerId = layerId;
  const R = 6371000, k = Math.PI / 180;
  const proj = n => ({
    x: (n.lon - c.lon) * k * R * Math.cos(c.lat * k) + OSM_OFFSET.x,
    z: -(n.lat - c.lat) * k * R + OSM_OFFSET.z // север — в -Z
  });

  // Расширяем землю и отодвигаем туман, чтобы город не обрывался в пустоту
  ground.scale.set(10, 10, 1);
  ground.material.map.repeat.set(800, 800);
  scene.fog.near = 120;
  scene.fog.far = 450;

  osmGroup = new THREE.Group();
  scene.add(osmGroup);
  osmGroups.push(osmGroup);
  const subgroups = makeMapSubgroups(osmGroup);
  let roads = 0, buildings = 0, lights = 0, pedestrianWays = 0, cycleWays = 0, crossings = 0, labels = 0;
  let layerSpawn = null;

  // 3. Автомобильные дороги, названия, пешеходные и велосипедные объекты.
  const roadPos = [], roadIdx = [];
  for (const w of ways) {
    const tags=w.tags||{}, hw=tags.highway;
    const pts=w.nodes.map(id=>nodes.get(id)).filter(Boolean).map(proj);
    if(pts.length<2) continue;
    const isRoad=!!(hw && OSM_ROAD_W[hw]);
    const isPed=hw==='footway'||hw==='pedestrian'||hw==='steps'||hw==='path'&&(tags.foot==='yes'||(tags.bicycle!=='designated'&&tags.bicycle!=='yes'));
    const isCycle=hw==='cycleway'||(hw==='path'&&(tags.bicycle==='designated'||tags.bicycle==='yes'));
    const isCrossing=tags.footway==='crossing'||hw==='crossing';
    if(isRoad) {
      if(!osmSpawn) {
        const first=pts[0], second=pts[1], ang=Math.atan2(second.x-first.x,second.z-first.z);
        layerSpawn={x:first.x,z:first.z,h:ang}; osmSpawn=layerSpawn;
      }
      let width=parseFloat(tags.width);
      if(isNaN(width)){const lanes=parseInt(tags.lanes,10);width=!isNaN(lanes)?lanes*3.5:OSM_ROAD_W[hw];}
      addRibbon(pts,width/2,.015,roadPos,roadIdx); roads++;
      if(tags.name){labels+=addRoadNameLabel(subgroups.labels,String(tags.name),pts);}
      // Отдельные полосы/тротуары, описанные тегами на автомобильной дороге.
      const cycleTag=String(tags.cycleway||'');
      const cycleSides=[];
      if(cycleTag==='lane'||cycleTag==='opposite_lane'||cycleTag==='shared_lane') cycleSides.push(cycleTag==='opposite_lane'?-1:1);
      if(String(tags['cycleway:left']||'').match(/lane|track/)) cycleSides.push(-1);
      if(String(tags['cycleway:right']||'').match(/lane|track/)) cycleSides.push(1);
      for(const side of new Set(cycleSides)) {
        const track=String(side<0?tags['cycleway:left']:tags['cycleway:right'])==='track'||cycleTag==='track';
        addFlatRibbon(subgroups.cycle,offsetPolyline(pts,side*(width/2+(track?1.1:-.8))),track?2.0:1.25,.06,0x238b83); cycleWays++;
      }
      if(cycleTag==='track'&&!cycleSides.length){addFlatRibbon(subgroups.cycle,offsetPolyline(pts,width/2+1.1),2.0,.06,0x238b83);cycleWays++;}
      const sidewalk=String(tags.sidewalk||'');
      if(['both','left','right'].includes(sidewalk)) {
        const sides=sidewalk==='both'?[-1,1]:[sidewalk==='left'?1:-1];
        for(const side of sides){addFlatRibbon(subgroups.pedestrian,offsetPolyline(pts,side*(width/2+.85)),1.45,.045,0xb7b0a3);pedestrianWays++;}
      }
      if(tags.crossing==='marked'||tags.crossing==='traffic_signals') { addCrossingStripes(subgroups.crossings,pts); crossings++; }
    } else if(isPed) {
      const width=hw==='steps'?1.7:hw==='pedestrian'?4.0:2.0;
      addFlatRibbon(subgroups.pedestrian,pts,width,.045,0xb7b0a3); pedestrianWays++;
    } else if(isCycle) {
      addFlatRibbon(subgroups.cycle,pts,Math.max(1.8,parseFloat(tags.width)||2.0),.06,0x238b83); cycleWays++;
    }
    if(isCrossing){addCrossingStripes(subgroups.crossings,pts);crossings++;}
  }
  if(roadPos.length){
    const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(roadPos,3));g.setIndex(roadIdx);g.computeVertexNormals();
    const roadMat=new THREE.MeshStandardMaterial({color:0x3b3e42,roughness:.9,metalness:0,polygonOffset:true,polygonOffsetFactor:-1,side:THREE.DoubleSide});
    const roadMesh=new THREE.Mesh(g,roadMat);roadMesh.receiveShadow=true;subgroups.roads.add(roadMesh);
  }
  // 4. Здания: выдавленный контур + обводка граней для читаемости
  const bMat = matStd(0xb9b2a4, 0.0, 0.85);
  const edgeMat = new THREE.LineBasicMaterial({ color: 0x7d766b });
  for (const w of ways) {
    if (!w.tags || !w.tags.building || buildings >= 800) continue;
    const pts = w.nodes.map(id => nodes.get(id)).filter(Boolean).map(proj);
    if (pts.length < 4) continue;
    const h = parseFloat(w.tags.height) || (parseFloat(w.tags['building:levels']) || 2) * 3.2;
    const shape = new THREE.Shape(pts.map(p => new THREE.Vector2(p.x, -p.z)));
    const geo = new THREE.ExtrudeGeometry(shape, { depth: h, bevelEnabled: false });
    geo.rotateX(-Math.PI / 2);
    const mesh = new THREE.Mesh(geo, bMat);
    mesh.castShadow = true;
    mesh.receiveShadow = true;

    const line = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edgeMat);
    mesh.add(line);
    subgroups.buildings.add(mesh);

    // Коллизия по AABB контура
    let x1 = Infinity, x2 = -Infinity, z1 = Infinity, z2 = -Infinity;
    for (const p of pts) {
      x1 = Math.min(x1, p.x); x2 = Math.max(x2, p.x);
      z1 = Math.min(z1, p.z); z2 = Math.max(z2, p.z);
    }
    blocks.push({ x1, x2, z1, z2, osm: true, osmSourceId: layerId });
    buildings++;
  }

  // 5. Светофоры: расположение берётся из OSM; цикл переключения моделируется в симуляторе.
  for(const n of nodes.values()) {
    if(!n.tags) continue;
    const p=proj(n);
    if(n.tags.highway==='traffic_signals') {
      createTrafficSignal(subgroups.traffic,p,(lights*2.7)%12,false);
      cones.push({x:p.x,z:p.z,osm:true,osmSourceId:layerId}); lights++;
    }
    if(n.tags.highway==='crossing' || n.tags.crossing==='marked') {
      const crossingLine=[{x:p.x-2.4,z:p.z},{x:p.x+2.4,z:p.z}];
      addCrossingStripes(subgroups.crossings,crossingLine); crossings++;
    }
  }
  const layer = { id: layerId, name: options.name || `Район ${layerId}`, group: osmGroup, subgroups, roads, buildings, lights, pedestrianWays, cycleWays, crossings, labels, spawn: layerSpawn };
  osmLayers.push(layer);
  applyMapLayerVisibility();
  refreshMapLayerList();
  return { roads, buildings, lights, pedestrianWays, cycleWays, crossings, labels, layerId };
}

// Перенос машины в город или обратно на автодром
function teleportToCity() {
  if (!osmSpawn) return;
  Object.assign(state, osmSpawn, { v: 0, steer: 0 });
  swDeg = 0;
  contact = false;
  updateCamera(1);
}

// Загрузка локальных OSM JSON / GeoJSON и публичных URL.
const osmFileInput = document.getElementById('osmFile');
const osmStatusEl = document.getElementById('osmStatus');
const mapSourceUrl = document.getElementById('mapSourceUrl');
let mapLoadToken = 0;
function showMapResult(res, sourceLabel) {
  if (!osmStatusEl) return;
  osmStatusEl.innerHTML = `${escapeMapText(sourceLabel)}<br>дорог: ${res.roads}, зданий: ${res.buildings}, светофоров: ${res.lights}<br>` +
    `<button id="btnGoCity" style="margin-top:4px;cursor:pointer;">В город</button> ` +
    `<button id="btnGoPark" style="margin-top:4px;cursor:pointer;">На автодром</button>`;
  document.getElementById('btnGoCity').onclick = teleportToCity;
  document.getElementById('btnGoPark').onclick = reset;
  if (osmSpawn) teleportToCity();
  else osmStatusEl.innerHTML += '<br>(дороги для движения не найдены)';
}
function parseAndLoadMap(text, sourceLabel, append = false) {
  const data = JSON.parse(text);
  const res = loadOsm(data, { append, name: sourceLabel });
  showMapResult(res, sourceLabel);
  return res;
}
if (osmFileInput) {
  osmFileInput.addEventListener('change', async e => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;
    const token = ++mapLoadToken;
    const append = document.getElementById('appendMapLayer').checked && osmLayers.length > 0;
    if (osmStatusEl) osmStatusEl.textContent = `чтение файлов: ${files.length}...`;
    try {
      const contents = await Promise.all(files.map(file => file.text()));
      if (token !== mapLoadToken) return;
      // Сначала проверяем, что все файлы являются допустимыми данными.
      const parsed = contents.map((txt, i) => ({ data: JSON.parse(txt), name: files[i].name }));
      parsed.forEach(item => validateMapInput(item.data));
      let modeAppend = append;
      for (const item of parsed) {
        if (token !== mapLoadToken) return;
        parseAndLoadMap(JSON.stringify(item.data), `Источник: ${item.name}`, modeAppend);
        modeAppend = true;
      }
      if (osmFileInput) osmFileInput.value = '';
    } catch (err) {
      if (osmStatusEl) osmStatusEl.textContent = 'ошибка загрузки: ' + err.message;
    }
  });
}
const btnLoadUrl = document.getElementById('btnLoadUrl');
if (btnLoadUrl) btnLoadUrl.addEventListener('click', async () => {
  const url = (mapSourceUrl && mapSourceUrl.value || '').trim();
  if (!url) { if (osmStatusEl) osmStatusEl.textContent = 'укажите публичный URL GeoJSON или OSM JSON'; return; }
  let parsed;
  try { parsed = new URL(url); } catch (_) { if (osmStatusEl) osmStatusEl.textContent = 'некорректный URL'; return; }
  if (!['http:','https:'].includes(parsed.protocol)) { if (osmStatusEl) osmStatusEl.textContent = 'разрешены только HTTP/HTTPS URL'; return; }
  const token = ++mapLoadToken;
  if (osmStatusEl) osmStatusEl.textContent = 'загрузка источника...';
  btnLoadUrl.disabled = true;
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 20000);
  try {
    const response = await fetch(url, { signal:controller.signal, headers:{ 'Accept':'application/geo+json, application/json' } });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const body = await response.text();
    if (token !== mapLoadToken) return;
    validateMapInput(JSON.parse(body));
    parseAndLoadMap(body, `Источник: ${parsed.hostname}`, document.getElementById('appendMapLayer').checked && osmLayers.length > 0);
  } catch (err) {
    if (token === mapLoadToken && osmStatusEl) {
      const msg = err.name === 'AbortError' ? 'превышено время ожидания (20 с)' : err.message;
      osmStatusEl.textContent = 'не удалось загрузить URL: ' + msg + '. Проверьте доступность адреса и CORS.';
    }
  } finally {
    clearTimeout(timeout);
    btnLoadUrl.disabled = false;
  }
});
const btnClearMap = document.getElementById('btnClearMap');
if (btnClearMap) btnClearMap.addEventListener('click', () => {
  ++mapLoadToken;
  clearOsmMap();
  for (const p of [...mapPois]) removeMapPoi(p.id);
  if (osmFileInput) osmFileInput.value = '';
  if (mapSourceUrl) mapSourceUrl.value = '';
  if (osmStatusEl) osmStatusEl.textContent = 'карта очищена; исходный автодром сохранён';
  if (typeof reset === 'function') reset();
});

// Пользовательские учебные и экзаменационные точки (координаты WGS84).
function escapeMapText(value) { return String(value).replace(/[&<>\"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch])); }
function renderPoiList() {
  const el = document.getElementById('poiList');
  if (!el) return;
  el.innerHTML = mapPois.length ? mapPois.map(p => `<div style="margin:3px 0;display:flex;gap:4px;align-items:center;"><span style="flex:1;">${p.type === 'exam' ? '🟠' : '🟢'} ${escapeMapText(p.name)}</span><button data-poi-remove="${p.id}">×</button></div>`).join('') : 'точек пока нет';
  el.querySelectorAll('[data-poi-remove]').forEach(b => b.addEventListener('click', () => removeMapPoi(Number(b.dataset.poiRemove))));
}
function ensurePoiGroup() {
  if (!poiGroup) { poiGroup = new THREE.Group(); scene.add(poiGroup); }
}
function addMapPoi(name, type, lat, lon) {
  if (!Number.isFinite(lat) || !Number.isFinite(lon) || Math.abs(lat) > 90 || Math.abs(lon) > 180) throw new Error('проверьте широту и долготу');
  if (!mapProjectionCenter) mapProjectionCenter = { lat, lon };
  const R=6371000, k=Math.PI/180, c=mapProjectionCenter;
  const x=(lon-c.lon)*k*R*Math.cos(c.lat*k)+OSM_OFFSET.x;
  const z=-(lat-c.lat)*k*R+OSM_OFFSET.z;
  ensurePoiGroup();
  const color = type === 'exam' ? 0xff8c32 : 0x39c96b;
  const marker = new THREE.Mesh(new THREE.CylinderGeometry(0.45,0.45,0.16,16), new THREE.MeshStandardMaterial({color, emissive:color, emissiveIntensity:0.25}));
  marker.position.set(x,0.12,z); poiGroup.add(marker);
  const id = Date.now() + Math.floor(Math.random()*1000);
  mapPois.push({id,name,type,lat,lon,marker});
  renderPoiList();
}
function removeMapPoi(id) {
  const i=mapPois.findIndex(p=>p.id===id); if(i<0)return;
  const p=mapPois[i]; poiGroup.remove(p.marker); p.marker.geometry.dispose(); p.marker.material.dispose(); mapPois.splice(i,1);
  if(!mapPois.length && poiGroup){scene.remove(poiGroup);poiGroup=null;}
  if(!mapPois.length && !osmLayers.length) mapProjectionCenter=null;
  renderPoiList();
}
const btnAddPoi=document.getElementById('btnAddPoi');
if(btnAddPoi) btnAddPoi.addEventListener('click',()=>{
  const name=(document.getElementById('poiName').value||'').trim() || 'Без названия';
  const type=document.getElementById('poiType').value;
  const latText=document.getElementById('poiLat').value, lonText=document.getElementById('poiLon').value;
  const lat=latText.trim()===''?NaN:Number(latText), lon=lonText.trim()===''?NaN:Number(lonText);
  try { addMapPoi(name,type,lat,lon); if(osmStatusEl) osmStatusEl.textContent='точка добавлена'; }
  catch(err){ if(osmStatusEl) osmStatusEl.textContent=err.message; }
});

// Старт основного цикла
updateCamera(1);
requestAnimationFrame(loop);
</script>
