function removeOsmLayer(id) {
  const index = osmLayers.findIndex(x => x.id === id);
  if (index < 0) return;
  const layer = osmLayers[index];
  disposeThreeGroup(layer.group);
  osmLayers.splice(index, 1);
  for (let i=blocks.length-1;i>=0;i--) if (blocks[i].osmSourceId === id) blocks.splice(i,1);
  for (let i=cones.length-1;i>=0;i--) if (cones[i].osmSourceId === id) cones.splice(i,1);
  osmGroups = osmLayers.map(x => x.group);
  osmGroup = osmGroups[osmGroups.length - 1] || null;
  trafficSignals = trafficSignals.filter(signal => signal.sourceId !== id);
  if (activeOsmLayerId === id) activeOsmLayerId = null;
  osmSpawn = (osmLayers.find(x => x.spawn) || {}).spawn || null;
  if (!osmLayers.length) {
    if (!mapPois.length) mapProjectionCenter = null;
    ground.scale.set(1, 1, 1);
    if (ground.material && ground.material.map) ground.material.map.repeat.set(80, 80);
    scene.fog.near = 60; scene.fog.far = 220;
