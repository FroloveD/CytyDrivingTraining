function clearOsmMap() {
  osmGroups.forEach(disposeThreeGroup);
  osmGroups = []; osmLayers = []; osmGroup = null; osmSpawn = null; trafficSignals = [];
  if (!mapPois.length) mapProjectionCenter = null;
  activeOsmLayerId = null;
  for (let i=blocks.length-1;i>=0;i--) if (blocks[i].osm) blocks.splice(i,1);
  for (let i=cones.length-1;i>=0;i--) if (cones[i].osm) cones.splice(i,1);
  ground.scale.set(1, 1, 1);
  if (ground.material && ground.material.map) ground.material.map.repeat.set(80, 80);
  scene.fog.near = 60; scene.fog.far = 220;
  refreshMapLayerList();
}

function validateMapInput(inputData) {
  const data = inputData && inputData.type === 'FeatureCollection' ? geoJsonToOsm(inputData) : inputData;
  if (!data || !Array.isArray(data.elements)) throw new Error('ожидался OSM JSON или GeoJSON FeatureCollection');
  const hasNodes = data.elements.some(e => e && e.type === 'node' && Number.isFinite(e.lat) && Number.isFinite(e.lon));
  const hasWays = data.elements.some(e => e && e.type === 'way' && Array.isArray(e.nodes));
  if (!hasNodes || !hasWays) throw new Error('в источнике не найдены совместимые узлы и линейные объекты');
  return true;
}

function makeMapSubgroups(root) {
  const groups = {};
  for (const key of ['roads','labels','pedestrian','cycle','crossings','traffic','buildings']) {
    groups[key] = new THREE.Group(); groups[key].name = `osm-${key}`; root.add(groups[key]);
  }
