}
function addRoadNameLabel(group, text, pts) {
  if (!text || pts.length < 2) return 0;
  const canvas = document.createElement('canvas'), ctx = canvas.getContext('2d');
  const fontSize = 48; ctx.font = `600 ${fontSize}px Arial, sans-serif`;
  canvas.width = Math.min(Math.max(Math.ceil(ctx.measureText(text).width + 34),180),1024); canvas.height = 84;
  ctx.font = `600 ${fontSize}px Arial, sans-serif`; ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.lineWidth=7; ctx.strokeStyle='rgba(20,24,28,.82)'; ctx.fillStyle='#fff';
  ctx.strokeText(text,canvas.width/2,canvas.height/2); ctx.fillText(text,canvas.width/2,canvas.height/2);
  const texture=new THREE.CanvasTexture(canvas); texture.minFilter=THREE.LinearFilter;
  let total=0; const lengths=[];
  for(let i=1;i<pts.length;i++){const d=Math.hypot(pts[i].x-pts[i-1].x,pts[i].z-pts[i-1].z);lengths.push(d);total+=d;}
  const targets=[]; if(total<150) targets.push(total/2); else for(let d=75;d<total;d+=150) targets.push(d);
  for(const target of targets){
    let acc=0, index=0; while(index<lengths.length-1 && acc+lengths[index]<target){acc+=lengths[index];index++;}
    const t=lengths[index]?(target-acc)/lengths[index]:0, a=pts[index],b=pts[index+1];
    const x=a.x+(b.x-a.x)*t,z=a.z+(b.z-a.z)*t,angle=Math.atan2(b.x-a.x,b.z-a.z);
    const spriteMaterial=new THREE.SpriteMaterial({map:texture,transparent:true,depthWrite:false,sizeAttenuation:true,rotation:-angle});
    const sprite=new THREE.Sprite(spriteMaterial); sprite.position.set(x,.48,z);
    sprite.scale.set(Math.max(8,Math.min(30,text.length*1.05)),1.45,1);
    group.add(sprite);
  }
  return targets.length;
}
function offsetPolyline(pts, offset) {
  return pts.map((p,i) => {
    const a=pts[Math.max(0,i-1)], b=pts[Math.min(pts.length-1,i+1)];
    const dx=b.x-a.x, dz=b.z-a.z, len=Math.hypot(dx,dz)||1;
    return {x:p.x-(dz/len)*offset, z:p.z+(dx/len)*offset};
  });
}
function addFlatRibbon(group, pts, width, y, color) {
  if (pts.length<2) return;
  const pos=[], idx=[]; addRibbon(pts,width/2,y,pos,idx);
  const geo=new THREE.BufferGeometry(); geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3)); geo.setIndex(idx); geo.computeVertexNormals();
  const mat=new THREE.MeshStandardMaterial({color,roughness:.95,side:THREE.DoubleSide,polygonOffset:true,polygonOffsetFactor:-2});
  const mesh=new THREE.Mesh(geo,mat); mesh.receiveShadow=true; group.add(mesh); return mesh;
}
function addCrossingStripes(group, pts) {
  if (pts.length<2) return;
  const a=pts[0], b=pts[pts.length-1], dx=b.x-a.x, dz=b.z-a.z, len=Math.hypot(dx,dz)||1;
  const nx=-dz/len, nz=dx/len;
  const center=pts[Math.floor(pts.length/2)];
  for(let i=-3;i<=3;i++) {
    const cx=center.x+nx*i*0.85, cz=center.z+nz*i*0.85;
    const stripe=[{x:cx-dx/len*2.2,z:cz-dz/len*2.2},{x:cx+dx/len*2.2,z:cz+dz/len*2.2}];
    addFlatRibbon(group,stripe,0.48,0.075,0xe9e9df);
  }
}
function createTrafficSignal(group, p, phaseOffset=0, pedestrian=false) {
  const poleMat=matStd(0x343941,.55,.5);
  const housingMat=matStd(0x171a1e,.25,.65);
  const pole=new THREE.Mesh(new THREE.CylinderGeometry(.075,.09,4.0,8),poleMat); pole.position.set(p.x,2,p.z); group.add(pole);
  const housing=new THREE.Mesh(new THREE.BoxGeometry(.38,1.0,.32),housingMat); housing.position.set(p.x,3.85,p.z); group.add(housing);
  const lamps=[];
  const colors=[0xff2929,0xffc928,0x27d65a];
  for(let i=0;i<3;i++) {
    const mat=new THREE.MeshStandardMaterial({color:colors[i],emissive:colors[i],emissiveIntensity:.08,roughness:.35});
    const lamp=new THREE.Mesh(new THREE.SphereGeometry(.105,12,8),mat); lamp.position.set(p.x,4.18-i*.32,p.z+.17); group.add(lamp); lamps.push(lamp);
