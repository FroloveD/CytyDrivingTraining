// ленточная дорога: полоса шириной 2·halfW вдоль ломаной линии
function addRibbon(pts, halfW, y, pos, idx) {
  const n = pts.length, base = pos.length / 3;
  const perp = (a, b) => {
    const dx = b.x - a.x, dz = b.z - a.z;
    const L = Math.hypot(dx, dz) || 1;
    return { x: -dz / L, z: dx / L };
  };
  for (let i = 0; i < n; i++) {
    const p = pts[i];
    let nx = 0, nz = 0;
    if (i > 0) { const q = perp(pts[i - 1], p); nx += q.x; nz += q.z; }
    if (i < n - 1) { const q = perp(p, pts[i + 1]); nx += q.x; nz += q.z; }
    const L = Math.hypot(nx, nz) || 1;
    nx /= L; nz /= L;
    pos.push(p.x + nx * halfW, y, p.z + nz * halfW, p.x - nx * halfW, y, p.z - nz * halfW);
  }
  for (let i = 0; i < n - 1; i++) {
    const a = base + 2 * i;
    idx.push(a, a + 2, a + 1, a + 1, a + 2, a + 3);
  }
}

// Преобразует GeoJSON (WGS84: [долгота, широта]) в совместимую
// внутреннюю структуру OSM. Поддерживаются LineString/MultiLineString,
// Polygon/MultiPolygon и Point/MultiPoint.
function geoJsonToOsm(data) {
  if (!data || data.type !== 'FeatureCollection' || !Array.isArray(data.features)) {
    throw new Error('ожидался GeoJSON FeatureCollection');
  }
  const elements = [], nodes = new Map();
  let nextNodeId = -1, nextWayId = -1;
  const addLine = (coords, props, polygon=false) => {
    if (!Array.isArray(coords) || coords.length < (polygon ? 4 : 2)) return;
    const tags = { ...(props || {}) };
    if (polygon) {
      const buildingFlag = String(tags.building || tags.class || tags.feature || tags.type || '').toLowerCase();
      if (!(tags.building || buildingFlag === 'building')) return;
      if (!tags.building) tags.building = 'yes';
    } else if (!tags.highway) {
      const kind = String(tags.road || tags.road_type || tags.kind || tags.class || tags.fclass || tags.type || '').toLowerCase();
      const roadTypes = { motorway:'motorway',trunk:'trunk',primary:'primary',secondary:'secondary',tertiary:'tertiary',residential:'residential',unclassified:'unclassified',service:'service',living_street:'living_street',street:'residential',road:'residential',footway:'footway',pedestrian:'pedestrian',steps:'steps',path:'path',cycleway:'cycleway' };
      if (!roadTypes[kind]) return;
      tags.highway = roadTypes[kind];
    }
    const ids = [];
    for (const c of coords) {
      if (!Array.isArray(c) || !Number.isFinite(Number(c[0])) || !Number.isFinite(Number(c[1]))) continue;
      const id = nextNodeId--;
      const n = { type:'node', id, lon:Number(c[0]), lat:Number(c[1]) };
      nodes.set(id,n); elements.push(n); ids.push(id);
    }
    if (ids.length >= (polygon ? 4 : 2)) elements.push({ type:'way', id:nextWayId--, nodes:ids, tags });
  };
  const addPoint = (coord, props) => {
    if (!Array.isArray(coord) || !Number.isFinite(Number(coord[0])) || !Number.isFinite(Number(coord[1]))) return;
    const tags = { ...(props || {}) };
    const label = String(tags.highway || tags.kind || tags.type || tags.amenity || '').toLowerCase();
    if (label.includes('traffic') || label.includes('signal') || label === 'traffic_signals') tags.highway = 'traffic_signals';
    else if (label === 'crossing' || tags.crossing === 'marked') tags.highway = 'crossing';
    else return;
    elements.push({ type:'node', id:nextNodeId--, lon:Number(coord[0]), lat:Number(coord[1]), tags });
  };
  for (const feature of data.features) {
    if (!feature || feature.type !== 'Feature' || !feature.geometry) continue;
    const g=feature.geometry, props=feature.properties || {};
    if (g.type==='LineString') addLine(g.coordinates,props,false);
    else if (g.type==='MultiLineString') (g.coordinates||[]).forEach(c=>addLine(c,props,false));
    else if (g.type==='Polygon') addLine(g.coordinates && g.coordinates[0],props,true);
    else if (g.type==='MultiPolygon') (g.coordinates||[]).forEach(poly=>addLine(poly && poly[0],props,true));
    else if (g.type==='Point') addPoint(g.coordinates,props);
    else if (g.type==='MultiPoint') (g.coordinates||[]).forEach(c=>addPoint(c,props));
  }
  if (!elements.some(e=>e.type==='way')) throw new Error('в GeoJSON не найдены линейные объекты или контуры зданий');
  return { elements };
}

function disposeThreeGroup(group) {
  if (!group) return;
  scene.remove(group);
  const geometries = new Set(), materials = new Set(), textures = new Set();
  group.traverse(o => {
    if (o.geometry) geometries.add(o.geometry);
    if (o.material) (Array.isArray(o.material) ? o.material : [o.material]).forEach(m => {
      materials.add(m);
      for (const key of Object.keys(m)) { const value=m[key]; if(value && value.isTexture) textures.add(value); }
    });
  });
  geometries.forEach(g => g.dispose());
  materials.forEach(m => m.dispose());
  textures.forEach(t => t.dispose());
}
const MAP_LAYER_DEFAULTS = { roads:true, labels:true, pedestrian:true, cycle:true, crossings:true, traffic:true, buildings:true };
function mapLayerEnabled(name) {
