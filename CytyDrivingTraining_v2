// ================= геометрия =================
const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));

// четыре угла кузова в мировых координатах
function corners(s) {
  const fx = Math.sin(s.h), fz = Math.cos(s.h);
  const rx = Math.cos(s.h), rz = -Math.sin(s.h);
  const pts = [];
  for (const f of [-CAR.rear, CAR.L + CAR.front])
    for (const l of [-CAR.half, CAR.half])
      pts.push([s.x + fx * f + rx * l, s.z + fz * f + rz * l]);
  return pts;
}

function carHits(s) {
  for (const [x, z] of corners(s))
    for (const b of blocks)
      if (x >= b.x1 && x <= b.x2 && z >= b.z1 && z <= b.z2) return true;

  // конус: центр в системе машины внутри кузова, расширенного на радиус
  const fx = Math.sin(s.h), fz = Math.cos(s.h);
  const rx = Math.cos(s.h), rz = -Math.sin(s.h);
  for (const c of cones) {
    const dx = c.x - s.x, dz = c.z - s.z;
    const f = dx * fx + dz * fz, l = dx * rx + dz * rz;
    if (f >= -CAR.rear - CONE_R && f <= CAR.L + CAR.front + CONE_R && Math.abs(l) <= CAR.half + CONE_R) return true;
  }
  return false;
}

// полностью ли машина внутри бокса (с запасом 2 см от линий и въезда)
// прямоугольник бокса в мировых координатах
function bayRect(bay) {
  if (bay.par) return { x1: bay.xc - PAR.l / 2, x2: bay.xc + PAR.l / 2, z1: bay.zc - PAR.w / 2, z2: bay.zc + PAR.w / 2 };
  const half = BAY.w / 2;
  return { x1: bay.xc - half, x2: bay.xc + half, z1: Math.min(bay.zE, bay.zB), z2: Math.max(bay.zE, bay.zB) };
}

// полностью ли машина внутри бокса (с запасом 2 см от линий и въезда)
function insideBay(s, bay) {
  const r = bayRect(bay);
  return corners(s).every(([x, z]) => x > r.x1 + 0.02 && x < r.x2 - 0.02 && z > r.z1 + 0.02 && z < r.z2 - 0.02);
}

// свободный бокс, в котором машина сейчас стоит целиком
function bayUnderCar(s) {
  for (const b of bays) if (!b.occupied && insideBay(s, b)) return b;
  return null;
}

// ================= логика =================
function update(dt) {
  // педали
  let a = 0;
  if (keys.KeyW || keys.ArrowUp) a += gear === 'D' ? 2.5 : -1.5;
  if (keys.KeyS || keys.ArrowDown) {
    const d = 6 * dt;   // тормоз только замедляет до нуля, не разворачивает
    state.v = state.v > 0 ? Math.max(0, state.v - d) : Math.min(0, state.v + d);
  }
  a -= 0.4 * state.v;   // сопротивление
  state.v = clamp(state.v + a * dt, -2.5, 6);

  // руль: плавно к цели, возврат к центру
  const turn = ((keys.KeyA || keys.ArrowLeft) ? 1 : 0) - ((keys.KeyD || keys.ArrowRight) ? 1 : 0);
  // отпустили ЛКМ на ходу — руль возвращается в центр; на стоянке остаётся в том положении, в котором был
  if (dragBtn !== 0 && Math.abs(state.v) > 0.05) swDeg += clamp(-swDeg, -720 * dt, 720 * dt);
  const mouseTarget = swDeg * Math.PI / 180 / SW.ratio;
  const target = turn !== 0 ? turn * CAR.maxSteer : mouseTarget;
  const rate = turn !== 0 ? 2.5 : 6.0;
  state.steer += clamp(target - state.steer, -rate * dt, rate * dt);

  // кинематическая модель «велосипед»
  const prev = { x: state.x, z: state.z, h: state.h };
  state.h += (state.v / CAR.L) * Math.tan(state.steer) * dt;
  state.x += Math.sin(state.h) * state.v * dt;
  state.z += Math.cos(state.h) * state.v * dt;

  // столкновение: откат к предыдущему кадру, одно касание на контакт
  if (carHits(state)) {
    if (!contact) collisions++;
    contact = true;
    Object.assign(state, prev, { v: 0 });
  } else {
    contact = false;
  }

  wheelSpin += state.v * dt / WHEEL_R;

  // подвеска: продольный тангаж от ускорения и поперечный крен от поворота
  const aLong = dt > 0 ? clamp((state.v - prevV) / dt, -4, 4) : 0;
  prevV = state.v;
  const pitchT = clamp(-aLong * 0.006, -0.03, 0.03);     // разгон — нос вверх, торможение — нос вниз
  const rollT = clamp(-state.v * state.steer * 0.02, -0.04, 0.04);   // поворот — кузов кренится наружу
  const kk = Math.min(1, dt * 6);
  pitchCur += (pitchT - pitchCur) * kk;
  rollCur += (rollT - rollCur) * kk;
  car.userData.chassis.rotation.x = pitchCur;
  car.userData.chassis.rotation.z = rollCur;

  // парковка: внутри свободного бокса и стоим 1.5 с
  elapsed += dt;
  const bay = bayUnderCar(state);
  const stopped = Math.abs(state.v) < 0.05;
  holdT = bay && stopped ? holdT + dt : 0;
  if (holdT > 1.5 && !finished) {
    finished = true;
    finishedBay = bay;
    score = Math.max(0, 100 - 15 * collisions);
    bay.lines.forEach(m => m.material.color.set(0x66ff66));
  }

  refreshStatus(bay);
}

function refreshStatus(bay) {
  let text;
  if (finished) text = `Парковка в боксе №${finishedBay.id} выполнена! Балл: ${score}`;
  else if (contact) text = 'Касание! Отъедьте назад';
  else if (bay && holdT > 0) text = `Бокс №${bay.id}: держите остановку...`;
  else if (bay) text = `Бокс №${bay.id} — остановитесь`;
  else text = 'Заезжайте задним ходом в свободный бокс';
  statusEl.textContent = text;
}

function reset() {
  Object.assign(state, START, { v: 0, steer: 0 });
  collisions = 0; elapsed = 0; holdT = 0; finished = false; contact = false; score = 0;
  finishedBay = null;
  wheelSpin = 0;
  signal = null;
  bays.forEach(b => b.lines.forEach(m => m.material.color.set(0xffffff)));
  updateCamera(1);
}

// ================= камера =================
const camTarget = new THREE.Vector3();
function updateCamera(k) {
  // точка, за которой следим: центр кузова на высоте над дорогой
  const fx = Math.sin(state.h), fz = Math.cos(state.h);
  const cx = state.x + fx * CENTER, cz = state.z + fz * CENTER;
  // направление «сзади» плюс ручной поворот мышью
  const a = state.h + Math.PI + view.yaw;
  const horiz = view.r * Math.cos(view.el);
  const vert = view.r * Math.sin(view.el);
  camTarget.set(cx + Math.sin(a) * horiz, 1 + vert, cz + Math.cos(a) * horiz);
  camera.position.lerp(camTarget, k);
  camera.lookAt(cx, 1, cz);
}

function syncCar(now) {
  car.position.set(state.x, 0, state.z);
  car.rotation.y = state.h;
  car.userData.refreshLinks(state.steer);
  for (const p of car.userData.frontPivots) p.rotation.y = state.steer;
  car.userData.steerWheel.rotation.z = swDeg * Math.PI / 180;
  if (car.userData.updateDriver) car.userData.updateDriver();
  for (const w of car.userData.wheels) w.rotation.y = wheelSpin;
  const on = Math.floor(now / 400) % 2 === 0;   // мигание ~1,25 Гц
  car.userData.ampL.emissiveIntensity = signal === 'L' && on ? 1.5 : 0;
  car.userData.ampR.emissiveIntensity = signal === 'R' && on ? 1.5 : 0;
}

function updateTrafficSignals(now) {
  for(const signal of trafficSignals) {
    const phase=((now/1000+signal.phaseOffset)%12+12)%12;
    const active=phase<5?0:phase<6?1:2;
    signal.lamps.forEach((lamp,i)=>{lamp.material.emissiveIntensity=i===active?1.8:.06; lamp.material.needsUpdate=true;});
  }
}

function updateHud() {
  el('gear').textContent = gear;
  el('speed').textContent = Math.round(Math.abs(state.v) * 3.6);
  el('steer').textContent = Math.round(swDeg);
  el('coll').textContent = collisions;
  el('time').textContent = elapsed.toFixed(1);
  el('sig').textContent = signal === 'L' ? 'левый' : signal === 'R' ? 'правый' : 'выкл';
  document.getElementById('wheelRot').setAttribute('transform', `rotate(${-swDeg} 50 50)`);
}

// ================= цикл =================
let last = performance.now();
function loop(now) {
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;
  if (!finished) update(dt);
  syncCar(now);
  updateTrafficSignals(now);
  updateCamera(0.12);
  updateHud();
  renderMirror();
  updateMirrorHud();
  renderer.render(scene, camera);
  requestAnimationFrame(loop);
}

